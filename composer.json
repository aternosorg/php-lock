{
    "name": "aternos/lock",
    "description": "Distributed exclusive and shared resource locking based on etcd",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Matthias Neid",
            "email": "matthias@aternos.org"
        }
    ],
    "require": {
        "php": ">=8.5",
